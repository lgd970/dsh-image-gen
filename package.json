{
  "name": "dsh-image-gen",
  "version": "1.0.0",
  "description": "DSH image generation tools backed by an OpenAI-compatible /v1/images/generations relay (gpt-image-2.5-flare / gpt-image-2.5-sunburst)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
